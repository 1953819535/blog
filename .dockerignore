# .dockerignore
# 排除不需要复制到 Docker 镜像的文件

# 依赖目录
node_modules
**/node_modules

# 构建输出
dist
.output
.nuxt

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量文件
.env
.env.*
!.env.example

# IDE 配置
.idea
.vscode
*.swp
*.swo

# 测试相关
coverage
.nyc_output
**/*.spec.ts
**/*.test.ts
test

# Git
.git
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# 其他
*.md
!README.md
.DS_Store
Thumbs.db