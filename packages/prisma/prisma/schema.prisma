// 这是你的 Prisma schema 文件
// 在此处了解更多信息: https://pris.ly/d/prisma-schema

// 寻找加速查询或通过无服务器或边缘函数轻松扩展的方法吗？
// 尝试 Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

// datasource 定义了数据库连接信息
datasource db {
  // 指定数据库类型，这里是 PostgreSQL
  provider = "postgresql"
}

// 内容创作方式枚举
enum ContentAuthorship {
  HUMAN         // 完全由人类创作，无AI参与
  AI_ASSISTED   // 人类主导创作，AI提供辅助（如润色、语法检查、建议）
  AI_GENERATED  // 完全由AI生成，人类仅做少量编辑或未编辑
  COLLABORATIVE // 人类与AI深度协作，各自贡献显著内容
}

// 用户核心表
model User {
  id           String  @id @default(uuid()) // 使用 UUID
  email        String  @unique // 登录凭证
  password     String // 存 Hash 后的密码
  nickname     String  @default("用户") // 显示名称（可变）
  isActive     Boolean @default(true) @map("is_active") // 账号状态
  tokenVersion Int     @default(0) @map("token_version") // JWT token 版本号，用于使旧 token 失效

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  profile Profile? // 1:1 关系
  roles   UserRole[] // 角色 1:N 关系（指向中间表）
  posts   Post[] // 文章 1:N 关系（指向中间表）

  // 未来扩展
  // comments Comment[]

  @@map("users")
}

// 用户档案表 (1:1)
model Profile {
  id     String  @id @default(uuid()) // 统一使用 UUID
  userId String  @unique @map("user_id") // 外键 + Unique
  avatar String? // 头像 URL
  bio    String? // 个人简介

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// 角色表 (字典表)
model Role {
  id          String  @id // 使用字符串 ID，如: 'admin', 'user'
  description String?
  isSystem    Boolean @default(false) @map("is_system") // 系统角色不可删除

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

// 用户-角色中间表 (M:N)
model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id") // 改为 String，对应 Role.id
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId]) // 复合主键
  @@map("user_roles")
}

// --------------------------------------------------------
// 博客核心业务模块 (Post, Category, Tag)
// --------------------------------------------------------

/**
 * 文章表 (Post)
 * 核心内容存放处。
 * 关于图片处理：
 * `content` 字段存储 Markdown 文本。
 * 当你在 Service 层执行 "移动图片" 逻辑后，
 * 存入这里的文本中的图片链接应该是: https://cdn.yours.com/posts/uuid/image.png (永久路径)
 */
model Post {
  id    String @id @default(uuid())
  title String // 文章标题

  // URL 友好标识
  // 作用：前端路由使用 /post/nestjs-r2-upload 而不是 /post/123-456
  // 这是一个 SEO 关键字段，必须唯一且加索引
  slug String @unique

  // 文章摘要
  // 用于在文章列表页展示，避免加载全文，提升列表页查询速度
  excerpt String? @db.Text

  // 文章正文
  // 使用 @db.Text 以支持长文本（PostgreSQL Text 类型无长度限制）
  // 这里存的是 Markdown 源码
  content String @db.Text

  // 封面图 URL (可选)
  coverImage String? @map("cover_image")

  // 状态控制
  published   Boolean   @default(false) // false=草稿, true=已发布
  publishedAt DateTime? @map("published_at") // 实际发布时间，用于排序

  // 统计数据
  // 简单计数，如果并发极高(每秒几百次写入)建议以后拆分出去，个人博客足够用
  viewCount Int @default(0) @map("view_count")

  // AI 创作标记
  aiAuthorship ContentAuthorship @default(HUMAN) @map("ai_authorship") // 内容创作方式
  aiTool       String?            @map("ai_tool") // 使用的AI工具名称（如 "GPT-4", "Claude"）

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // === 关联 ===

  // 作者
  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id])

  // 分类 (1:N) - 一篇文章属于一个主分类 (类似文件夹)
  // 这里的 onDelete: SetNull 表示如果分类被删除，文章不会被删，只是变成未分类
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // 标签 (N:M) - 一篇文章可以有多个标签 (类似贴纸)
  // Prisma 会自动维护隐式中间表 `_PostToTag`
  tags Tag[]

  // 索引优化
  @@index([slug]) // 加速详情页查询
  @@index([published, publishedAt]) // 加速列表页查询 (只查已发布的)
  @@index([authorId]) // 加速查询某人的文章
  @@map("posts")
}

/**
 * 分类表 (Category)
 * 用于构建网站的导航结构，如：后端、前端、随笔
 */
model Category {
  id          String  @id @default(uuid())
  name        String  @unique // 分类名必须唯一，如 "Backend"
  slug        String  @unique // URL 标识，如 "backend"
  description String? // 分类描述，用于 SEO meta description

  posts Post[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

/**
 * 标签表 (Tag)
 * 用于描述内容的具体属性，如：NestJS, Prisma, Docker
 * 相比分类更扁平、更灵活
 */
model Tag {
  id   String @id @default(uuid())
  name String @unique // 标签名
  slug String @unique // URL 标识

  posts Post[]

  // 不需要 createdAt/updatedAt，通常标签只增不改
  @@map("tags")
}
